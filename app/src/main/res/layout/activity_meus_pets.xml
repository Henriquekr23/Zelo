<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/zelo_background"
    tools:context=".MeusPetsActivity">

    <!-- Barra Laranja Superior com Design unificado -->
    <LinearLayout
        android:id="@+id/layoutHeaderMeusPets"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/zelo_primary"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="48dp"
        android:paddingBottom="24dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVoltarMeusPets"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="‹"
                android:textColor="@color/white"
                android:textSize="28sp"
                app:backgroundTint="@android:color/transparent" />

            <TextView
                android:id="@+id/txtTituloMeusPets"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="@string/titulo_meus_pets"
                android:textColor="@color/white"
                android:textSize="26sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:id="@+id/txtSubtituloMeusPets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginStart="48dp"
            android:text="@string/subtitulo_meus_pets"
            android:textColor="#E0E0E0"
            android:textSize="15sp" />

    </LinearLayout>

    <GridView
        android:id="@+id/gridViewPets"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:clipToPadding="false"
        android:gravity="center"
        android:horizontalSpacing="4dp"
        android:verticalSpacing="4dp"
        android:numColumns="2"
        android:stretchMode="columnWidth"
        android:paddingHorizontal="20dp"
        app:layout_constraintBottom_toTopOf="@id/composeViewBottomNavPets"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutHeaderMeusPets"
        tools:listitem="@layout/item_pet_grid" />

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/composeViewBottomNavPets"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="14dp"
    app:cardBackgroundColor="#F8FAFC"
    app:cardElevation="0dp"
    app:strokeColor="#E2E8F0"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/txtDataAgendamentoDetalhes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📅 20/10/2026"
            android:textColor="#0F172A"
            android:textSize="15sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/txtHorarioAgendamentoDetalhes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="🕒 14:30"
            android:textColor="#475569"
            android:textSize="13sp"/>

        <TextView
            android:id="@+id/txtDescricaoAgendamentoDetalhes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Consulta veterinária"
            android:textColor="#334155"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/txtStatusAgendamentoDetalhes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="Agendado"
            android:textColor="#475569"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@android:color/transparent" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
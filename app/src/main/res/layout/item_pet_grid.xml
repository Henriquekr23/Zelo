<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardBackgroundColor="@color/zelo_surface"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/zelo_outline"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="16dp">

        <TextView
            android:id="@+id/txtEmojiPet"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_avatar_pet"
            android:gravity="center"
            android:textSize="28sp"
            tools:text="🐶" />

        <TextView
            android:id="@+id/txtNomePet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/zelo_text"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Frida" />

        <TextView
            android:id="@+id/txtEspecieRaca"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/zelo_text_secondary"
            android:textSize="12sp"
            tools:text="Gata • Persa" />

        <TextView
            android:id="@+id/txtIdadePet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_status_confirmado"
            android:textColor="@color/zelo_sage_text"
            android:textSize="10sp"
            android:textStyle="bold"
            tools:text="3 ANOS" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>

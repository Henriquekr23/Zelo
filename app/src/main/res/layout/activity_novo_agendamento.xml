<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".NovoAgendamentoActivity">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/txtTituloNovoAgendamento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/titulo_novo_agendamento"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/subtitulo_novo_agendamento"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/edtNomePet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:hint="@string/nome_pet"
            android:inputType="textCapWords"
            android:maxLines="1" />

        <EditText
            android:id="@+id/edtData"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/data_agendamento"
            android:inputType="date"
            android:maxLines="1" />

        <EditText
            android:id="@+id/edtHorario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/horario_agendamento"
            android:inputType="time"
            android:maxLines="1" />

        <EditText
            android:id="@+id/edtDescricao"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="16dp"
            android:gravity="top|start"
            android:hint="@string/descricao_agendamento"
            android:inputType="textCapSentences|textMultiLine"
            android:padding="12dp" />

        <Button
            android:id="@+id/btnSalvar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/salvar_agendamento" />

    </LinearLayout>

</ScrollView>